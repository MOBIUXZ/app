{
  "app": {
    "logo": {
      "text": "Orbius",
      "component": "src/components/Logo.jsx",
      "size": 32,
      "rounded": true
    },
    "favicon": "/favicon.svg",
    "faviconIco": "/favicon.ico",
    "appleTouchIcon": "/icons/icon-180.png",
    "documentTitle": "Orbius — Always in orbit. Always evolving.",
    "cssModule": "src/App.module.css",
    "settings": {
      "icon": "settings",
      "ariaLabel": "Settings",
      "iconSizePx": 22,
      "modal": {
        "id": "settings",
        "title": "Settings",
        "layerId": "settings",
        "staysMountedUnder": ["wipe-all-logs", "import-backup"],
        "layout": "compact",
        "maxWidthPx": 400,
        "sections": [
          {
            "id": "profile",
            "title": "Profile",
            "type": "fields",
            "fields": [
              { "id": "sex", "label": "Sex", "control": "sexToggle", "path": "profile.sex", "options": ["male", "female"] },
              { "id": "height", "label": "Height", "unit": "cm", "control": "number", "path": "profile.height", "row": "measures" },
              { "id": "age", "label": "Age", "unit": "years", "control": "number", "path": "profile.age", "row": "measures" }
            ]
          },
          {
            "id": "calories",
            "title": "Calories",
            "type": "fields",
            "fields": [
              { "id": "goal", "label": "Daily goal", "unit": "kcal", "control": "number", "path": "calories.goal", "row": "intake" },
              { "id": "activity", "label": "Activity", "control": "activitySelect", "path": "calories.activityIndex", "row": "intake" }
            ]
          },
          {
            "id": "data",
            "title": "Data",
            "type": "actions",
            "hint": "Export includes workouts, InBody scans, other logs, and settings. Wipe deletes all logs and keeps settings. Body Comp Clear History deletes body-comp and weight logs only.",
            "actions": [
              { "id": "export", "label": "Export JSON", "row": "backup" },
              { "id": "import", "label": "Import JSON", "row": "backup" },
              { "id": "wipe", "label": "Wipe all logs", "style": "danger" }
            ]
          },
          {
            "id": "keyboard",
            "title": "Keyboard",
            "type": "rows",
            "rows": [
              { "keys": "1–5", "action": "Jump to page" },
              { "keys": "← →", "action": "Previous / next page" },
              { "keys": "Esc", "action": "Close popup" }
            ]
          }
        ]
      },
      "wipeModal": {
        "id": "wipeAllLogs",
        "title": "Wipe all logs?",
        "layerId": "wipe-all-logs",
        "buttons": ["Cancel", "Wipe logs"],
        "body": "This permanently deletes all workouts, body logs, body composition, and calorie entries. Profile and calorie defaults stay.",
        "stacksOver": "settings"
      },
      "importModal": {
        "id": "importBackup",
        "title": "Replace all data?",
        "layerId": "import-backup",
        "buttons": ["Cancel", "Import"],
        "body": "This replaces everything currently in Orbius with this backup: {workouts} workouts, {bodyLogs} body-weight logs, {bodyComp} body-comp entries, {calories} calorie entries.",
        "stacksOver": "settings"
      },
      "persistError": {
        "dismissAriaLabel": "Dismiss save error"
      }
    },
    "shellClasses": ["app", "header", "logo", "logoText", "settingsBtn", "persistBanner", "persistBannerText", "persistBannerClose", "settingsPanel", "settingsHeader", "settingsSection", "settingsSectionTitle", "settingsGrid", "settingsField", "settingsFieldRow", "settingsSexTrack", "settingsInputWrap", "settingsUnit", "settingsActions", "settingsActionsRow", "settingsHint", "settingsFileInput", "settingsRow", "settingsKeys", "settingsAction", "nav", "navTrack", "navBtn", "navBtnActive", "main"]
  },
  "pages": {
    "dashboard": {
      "id": "dashboard",
      "component": "src/components/DashboardPage.jsx",
      "cssModule": "src/components/DashboardPage.module.css",
      "pageTitle": "Dashboard",
      "pageIcon": "gauge",
      "statBoxes": [
        { "id": "bodyWeight", "label": "Body Weight", "unit": "kg", "valueKey": "lastBodyWeight" },
        { "id": "bodyFat", "label": "Body Fat", "unit": "%", "valueKey": "lastBodyFat", "colorToken": "pink" },
        { "id": "todayCals", "label": "Today Cals", "unit": "kcal", "valueKey": "todayCalories", "colorToken": "orange", "emptyAsNull": true },
        { "id": "workouts", "label": "Workouts", "unit": "", "valueKey": "workoutCount", "colorToken": "green" }
      ],
      "sections": [
        {
          "id": "personalRecords",
          "type": "card",
          "title": "🏆 Personal Records",
          "emptyIcon": "🏋️",
          "emptyMessage": "No workouts yet.",
          "emptyCta": "Log your first workout!",
          "emptyCtaTab": "Workout"
        }
      ],
      "collapses": [
        { "id": "recentWorkouts", "emoji": "📋", "label": "Recent Workouts", "defaultOpen": false, "emptyIcon": "📝", "emptyMessage": "Nothing logged yet!" }
      ]
    },
    "workout": {
      "id": "workout",
      "component": "src/components/WorkoutPage.jsx",
      "cssModule": "src/components/WorkoutPage.module.css",
      "hero": {
        "eyebrow": "Training dashboard",
        "title": "Workout Log",
        "icon": "activity",
        "statLayout": "filled-strip",
        "statMetrics": [
          { "id": "workouts", "label": "Workouts" },
          { "id": "unique", "label": "Unique" },
          { "id": "today", "label": "Today" }
        ],
        "todayDate": {
          "pattern": "D Mon YYYY",
          "monthCase": "shortTitle",
          "months": ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
          "fixtures": [
            { "iso": "2026-08-17", "expected": "17 Aug 2026" },
            { "iso": "2026-01-01", "expected": "1 Jan 2026" }
          ]
        }
      },
      "actions": [
        { "id": "calendar", "label": "📅 Open Calendar" },
        { "id": "smartParser", "label": "🧠 Smart Parser" }
      ],
      "collapses": [
        { "id": "logWorkout", "icon": "pencil-line", "label": "Log Workout", "defaultOpen": false },
        { "id": "history", "icon": "notebook", "label": "Workout History", "defaultOpen": false },
        { "id": "oneRm", "icon": "square-function", "label": "1RM Calculator", "defaultOpen": false }
      ],
      "manualLog": {
        "title": "Manual entry",
        "badge": "Quick log",
        "badgeStyle": "hint"
      },
      "historyGroups": {
        "defaultExpanded": true,
        "expandAllPersistsAcrossGrouping": true
      },
      "historySearch": {
        "placeholder": "Search by workout or date...",
        "matchFields": ["exercise", "date"]
      },
      "historyChrome": {
        "statsInSearch": false,
        "statsOnToolbar": false,
        "toolbarGapPx": 4,
        "groupCountStyle": "entries",
        "shortToggleLabels": true,
        "expandAllStyle": "text",
        "clearStyle": "quietPill",
        "clearLabel": "Clear History"
      },
      "modals": [
        { "id": "calendarModal", "title": "📅 Workout Calendar", "layerId": "calendar-modal", "monthMaxWidthPx": 389, "yearMaxWidthPx": 680 },
        { "id": "calendarDay", "title": "Day detail", "layerId": "calendar-day-panel", "staysMountedUnder": ["calendarLog", "deleteCalendarEntry"] },
        { "id": "calendarLog", "title": "✍️ Manual Log", "altTitle": "🧠 Smart Paste", "layerId": "calendar-log-panel", "stacksOver": "calendarDay" },
        { "id": "deleteCalendarEntry", "title": "Delete this workout?", "layerId": "delete-calendar-entry", "buttons": ["Cancel", "Delete"], "body": "This will permanently delete {exercise} on {date}.", "stacksOver": "calendarDay", "enterClass": "ft-kb-modal-backdrop", "portal": true, "zIndexFloor": 2000 },
        { "id": "smartParser", "title": "🧠 Smart Parser", "layerId": "smart-parser", "submitLabel": "Parse & Save", "iconInTitle": true },
        { "id": "setPicker", "title": "Select a logged set", "layerId": "set-picker" },
        { "id": "clearHistory", "title": "Clear Workout History?", "layerId": "clear-workout-history", "buttons": ["Cancel", "Clear History"] },
        { "id": "deleteEntry", "title": "Delete this workout?", "layerId": "delete-workout-entry", "buttons": ["Cancel", "Delete"], "body": "This will permanently delete {exercise} on {date}." }
      ]
    },
    "bodyComp": {
      "id": "bodyComp",
      "component": "src/components/BodyCompPage.jsx",
      "cssModule": "src/components/BodyCompPage.module.css",
      "pageTitle": "Body Composition",
      "pageIcon": "layers",
      "collapses": [
        { "id": "logEntry", "icon": "square-plus", "label": "Log Entry", "defaultOpen": false },
        { "id": "history", "icon": "history", "label": "History", "defaultOpen": false }
      ],
      "historyChrome": {
        "clearStyle": "quietPill",
        "clearLabel": "Clear History",
        "importLabel": "Import InBody CSV",
        "importAccept": ".csv,text/csv",
        "listAll": true
      },
      "historyChips": [
        { "id": "BW", "label": "BW", "unit": "kg", "colorToken": "accent", "paths": ["BW", "weight"] },
        { "id": "BMI", "label": "BMI", "unit": "kg/m²", "colorToken": "blue", "paths": ["BMI"] },
        { "id": "FM", "label": "FM", "unit": "kg", "colorToken": "pink", "paths": ["FM"] },
        { "id": "PBF", "label": "PBF", "unit": "%", "colorToken": "pink", "paths": ["PBF", "bf"] },
        { "id": "FMI", "label": "FMI", "unit": "kg/m²", "colorToken": "pink", "paths": ["FMI"], "derive": "fmi" },
        { "id": "FFM", "label": "FFM", "unit": "kg", "colorToken": "green", "paths": ["FFM"], "derive": "ffm" },
        { "id": "PFFM", "label": "FFM%", "unit": "%", "colorToken": "green", "paths": ["PFFM"], "derive": "ffmPct" },
        { "id": "FFMI", "label": "FFMI", "unit": "kg/m²", "colorToken": "accent", "paths": ["FFMI"], "derive": "ffmi" },
        { "id": "SMM", "label": "SMM", "unit": "kg", "colorToken": "green", "paths": ["SMM", "smm"] },
        { "id": "PSMM", "label": "MM%", "unit": "%", "colorToken": "green", "paths": ["PSMM"], "derive": "smmPct" },
        { "id": "SMI", "label": "SMI", "unit": "kg/m²", "colorToken": "orange", "paths": ["SMI"] },
        { "id": "BMR", "label": "BMR", "unit": "kcal", "colorToken": "orange", "paths": ["BMR_InBody"], "digits": 0 },
        { "id": "score", "label": "Score", "unit": "", "colorToken": "accent", "paths": ["inbody.score"], "digits": 0 },
        { "id": "visceral", "label": "VF", "unit": "", "colorToken": "orange", "paths": ["inbody.visceral"], "digits": 0 },
        { "id": "tbw", "label": "TBW", "unit": "L", "colorToken": "blue", "paths": ["inbody.tbw"] },
        { "id": "protein", "label": "Pro", "unit": "kg", "colorToken": "green", "paths": ["inbody.protein"] },
        { "id": "mineral", "label": "Min", "unit": "kg", "colorToken": "yellow", "paths": ["inbody.mineral"] }
      ],
      "segmentalMap": {
        "title": "🧍 Segmental Analysis",
        "unit": "kg",
        "imbalanceRatio": 0.05,
        "imbalanceRelativeTo": "min",
        "imbalanceTemplate": "{label} · Δ {delta} kg",
        "metrics": [
          { "id": "lean", "label": "Lean", "colorToken": "green" },
          { "id": "fat", "label": "Fat", "colorToken": "pink" }
        ],
        "segments": [
          { "id": "leftArm", "region": "arm", "side": "left", "label": "Left Arm", "leanPath": "inbody.leanLeftArmKg", "fatPath": "inbody.fatLeftArmKg" },
          { "id": "rightArm", "region": "arm", "side": "right", "label": "Right Arm", "leanPath": "inbody.leanRightArmKg", "fatPath": "inbody.fatRightArmKg" },
          { "id": "trunk", "region": "trunk", "side": "center", "label": "Trunk", "leanPath": "inbody.leanTrunkKg", "fatPath": "inbody.fatTrunkKg" },
          { "id": "leftLeg", "region": "leg", "side": "left", "label": "Left Leg", "leanPath": "inbody.leanLeftLegKg", "fatPath": "inbody.fatLeftLegKg" },
          { "id": "rightLeg", "region": "leg", "side": "right", "label": "Right Leg", "leanPath": "inbody.leanRightLegKg", "fatPath": "inbody.fatRightLegKg" }
        ],
        "pairs": [
          { "id": "arms", "label": "Arms", "left": "leftArm", "right": "rightArm" },
          { "id": "legs", "label": "Legs", "left": "leftLeg", "right": "rightLeg" }
        ]
      },
      "modals": [
        { "id": "clearHistory", "title": "Clear Body Comp History?", "layerId": "clear-body-comp-history", "buttons": ["Cancel", "Clear History"] },
        { "id": "deleteEntry", "title": "Delete this entry?", "layerId": "delete-body-comp-entry", "buttons": ["Cancel", "Delete"], "body": "This will permanently delete the {date} body composition entry and its body weight chart point." },
        { "id": "importInbody", "title": "Import InBody scans?", "layerId": "import-inbody", "buttons": ["Cancel", "Import"], "body": "This adds {added} new scans and replaces {replaced} existing dates. Same-day scans keep the latest reading. Incomplete rows skipped: {skipped}. Workouts and calories stay." }
      ]
    },
    "calories": {
      "id": "calories",
      "component": "src/components/CaloriePage.jsx",
      "cssModule": "src/components/CaloriePage.module.css",
      "pageTitle": "Calories",
      "pageIcon": "flame",
      "sections": [
        { "id": "bmrTdee", "title": "🔥 BMR & TDEE" },
        { "id": "dailyGoal", "title": "Daily Goal" }
      ],
      "collapses": [
        { "id": "customEntry", "emoji": "✏️", "label": "Custom Entry", "defaultOpen": false },
        { "id": "foodLog", "emoji": "📋", "label": "Log for {date}", "defaultOpen": true, "labelTemplate": true }
      ],
      "goalChips": [
        { "id": "cut", "label": "Cut (-500)", "colorToken": "red", "offsetKey": "cut" },
        { "id": "maintain", "label": "Maintain", "colorToken": "green", "offsetKey": "maintain" },
        { "id": "bulk", "label": "Bulk (+300)", "colorToken": "accent", "offsetKey": "bulk" }
      ],
      "tdeeBreakdown": {
        "layout": ["formula", "bar", "legend", "equation"],
        "formulaTemplates": {
          "mifflinMale": "BMR = 10 × weight + 6.25 × height − 5 × age + 5 (Male)",
          "mifflinFemale": "BMR = 10 × weight + 6.25 × height − 5 × age − 161 (Female)",
          "katch": "BMR = 370 + 21.6 × FFM (Katch-McArdle)"
        },
        "rows": [
          { "id": "bmr", "shortLabel": "BMR", "hint": "Basal metabolic rate", "colorToken": "orange" },
          { "id": "tef", "shortLabel": "TEF", "hint": "Food thermic effect · 10%", "colorToken": "yellow" },
          { "id": "neat", "shortLabel": "NEAT", "hint": "Non-exercise activity", "colorToken": "blue" },
          { "id": "eat", "shortLabel": "EAT", "hint": "Exercise activity", "colorToken": "blue" },
          { "id": "paee", "shortLabel": "PAEE", "hint": "Activity energy", "colorToken": "accent", "detailIds": ["neat", "eat"] }
        ],
        "equation": ["bmr", "tef", "paee"],
        "barSegments": [
          { "id": "bmr", "colorClass": "tdeeBarBmr" },
          { "id": "tef", "colorClass": "tdeeBarTef" },
          { "id": "paee", "colorClass": "tdeeBarPaee" }
        ]
      }
    },
    "progress": {
      "id": "progress",
      "component": "src/components/ProgressPage.jsx",
      "cssModule": "src/components/ProgressPage.module.css",
      "pageTitle": "Progress",
      "pageIcon": "chart-spline",
      "sections": [
        { "id": "compoundLifts", "label": "🏋️ COMPOUND LIFTS" },
        { "id": "combinedCompound", "title": "📊 Combined Compound Lifts" },
        { "id": "isolationLifts", "label": "💪 ISOLATION LIFTS" },
        { "id": "bodyCharts", "title": "📉 Body Weight" },
        { "id": "fat", "title": "📉 Fat Mass & Body Fat %" },
        { "id": "muscle", "title": "📉 Skeletal Muscle Mass & SMI" },
        { "id": "ffm", "title": "📉 Fat-Free Mass & FFMI" },
        { "id": "segmental", "title": "📉 Segmental Analysis" },
        { "id": "visceral", "title": "📉 Visceral Fat Level" },
        { "id": "composition", "title": "📉 Water, Protein & Mineral" },
        { "id": "bmr", "title": "📉 BMR (kcal/d)" },
        { "id": "inbodyScore", "title": "📉 InBody Score" },
        { "id": "calorieTrend", "title": "🔥 Calorie Intake Trend" }
      ],
      "bodyWeightChart": {
        "id": "weight",
        "title": "Body Weight (kg)",
        "unit": "kg",
        "colorToken": "accent",
        "dataKey": "weight"
      },
      "bodyChartExtras": [
        { "id": "bmi", "title": "BMI (kg/m²)", "colorToken": "accent", "paths": ["BMI"] }
      ],
      "fatTrends": {
        "tooltipValueTemplate": "{value} {unit}",
        "charts": [
          { "id": "fm", "title": "Fat Mass (kg)", "unit": "kg", "colorToken": "pink", "paths": ["FM", "fm"] },
          { "id": "bf", "title": "Body Fat %", "unit": "%", "colorToken": "pink", "paths": ["bf", "PBF"] },
          { "id": "fmi", "title": "FMI (kg/m²)", "unit": "kg/m²", "colorToken": "pink", "paths": ["FMI"], "derive": "fmi" }
        ]
      },
      "muscleTrends": {
        "tooltipValueTemplate": "{value} {unit}",
        "charts": [
          { "id": "smm", "title": "Skeletal Muscle Mass (kg)", "unit": "kg", "colorToken": "green", "paths": ["SMM", "smm"] },
          { "id": "smmPct", "title": "Muscle Mass %", "unit": "%", "colorToken": "green", "paths": ["PSMM"], "derive": "smmPct" },
          { "id": "smi", "title": "SMI (kg/m²)", "unit": "kg/m²", "colorToken": "green", "paths": ["SMI"] }
        ]
      },
      "ffmTrends": {
        "tooltipValueTemplate": "{value} {unit}",
        "charts": [
          { "id": "ffm", "title": "Fat-Free Mass (kg)", "unit": "kg", "colorToken": "cyan", "paths": ["FFM"], "derive": "ffm" },
          { "id": "ffmPct", "title": "Fat-Free Mass %", "unit": "%", "colorToken": "cyan", "paths": ["PFFM"], "derive": "ffmPct" },
          { "id": "ffmi", "title": "FFMI (kg/m²)", "unit": "kg/m²", "colorToken": "cyan", "paths": ["FFMI"], "derive": "ffmi" }
        ]
      },
      "visceralTrends": {
        "charts": [
          { "id": "visceral", "title": "Visceral Fat Level", "colorToken": "orange", "paths": ["inbody.visceral"] }
        ]
      },
      "bmrTrends": {
        "charts": [
          { "id": "bmr", "title": "BMR (kcal/d)", "colorToken": "yellow", "paths": ["BMR_InBody", "BMR_Mifflin", "BMR_Katch"] }
        ]
      },
      "scoreTrends": {
        "charts": [
          { "id": "score", "title": "InBody Score", "colorToken": "red", "paths": ["inbody.score"] }
        ]
      },
      "compositionTrends": {
        "tooltipValueTemplate": "{value} {unit}",
        "charts": [
          { "id": "tbw", "title": "Total Body Water (L)", "unit": "L", "colorToken": "blue", "paths": ["inbody.tbw"] },
          { "id": "protein", "title": "Protein (kg)", "unit": "kg", "colorToken": "blue", "paths": ["inbody.protein"] },
          { "id": "mineral", "title": "Mineral (kg)", "unit": "kg", "colorToken": "blue", "paths": ["inbody.mineral"] }
        ]
      },
      "segmentalBodyGrid": {
        "layout": "bodyGrid",
        "unit": "kg",
        "latestTemplate": "{value} {unit}",
        "tooltipValueTemplate": "{value} {unit}",
        "chartHeight": 110,
        "trunkChartHeight": 132,
        "imbalanceRatio": 0.05,
        "imbalanceRelativeTo": "min",
        "imbalanceTemplate": "{label} · Δ {delta} kg",
        "defaultMetric": "lean",
        "pairs": [
          { "id": "arms", "label": "Arms", "leftSlot": "leftArm", "rightSlot": "rightArm" },
          { "id": "legs", "label": "Legs", "leftSlot": "leftLeg", "rightSlot": "rightLeg" }
        ]
      },
      "segmentalTrendGroups": [
        {
          "id": "segmentalLean",
          "metric": "lean",
          "toggleLabel": "Soft Lean Mass",
          "charts": [
            { "id": "leanLeftArm", "slot": "leftArm", "scaleGroup": "arm", "title": "Left Arm", "colorToken": "teal", "paths": ["inbody.leanLeftArmKg"] },
            { "id": "leanRightArm", "slot": "rightArm", "scaleGroup": "arm", "title": "Right Arm", "colorToken": "teal", "paths": ["inbody.leanRightArmKg"] },
            { "id": "leanTrunk", "slot": "trunk", "scaleGroup": "trunk", "showDates": true, "title": "Trunk", "colorToken": "teal", "paths": ["inbody.leanTrunkKg"] },
            { "id": "leanLeftLeg", "slot": "leftLeg", "scaleGroup": "leg", "title": "Left Leg", "colorToken": "teal", "paths": ["inbody.leanLeftLegKg"] },
            { "id": "leanRightLeg", "slot": "rightLeg", "scaleGroup": "leg", "title": "Right Leg", "colorToken": "teal", "paths": ["inbody.leanRightLegKg"] }
          ]
        },
        {
          "id": "segmentalFat",
          "metric": "fat",
          "toggleLabel": "Fat Mass",
          "charts": [
            { "id": "fatLeftArm", "slot": "leftArm", "scaleGroup": "arm", "title": "Left Arm", "colorToken": "teal", "paths": ["inbody.fatLeftArmKg"] },
            { "id": "fatRightArm", "slot": "rightArm", "scaleGroup": "arm", "title": "Right Arm", "colorToken": "teal", "paths": ["inbody.fatRightArmKg"] },
            { "id": "fatTrunk", "slot": "trunk", "scaleGroup": "trunk", "showDates": true, "title": "Trunk", "colorToken": "teal", "paths": ["inbody.fatTrunkKg"] },
            { "id": "fatLeftLeg", "slot": "leftLeg", "scaleGroup": "leg", "title": "Left Leg", "colorToken": "teal", "paths": ["inbody.fatLeftLegKg"] },
            { "id": "fatRightLeg", "slot": "rightLeg", "scaleGroup": "leg", "title": "Right Leg", "colorToken": "teal", "paths": ["inbody.fatRightLegKg"] }
          ]
        }
      ],
      "chartMetrics": ["weight", "volume", "e1rm", "mean_e1rm"],
      "sessionGraphMetrics": ["weight", "volume", "e1rm"],
      "modals": [
        { "id": "workoutDetail", "title": "Workout Details", "layerId": "progress-detail" },
        { "id": "sessionGraph", "title": "Session Performance", "layerId": "progress-session-graph" }
      ]
    }
  }
}
