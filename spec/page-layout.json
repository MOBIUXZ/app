{
  "app": {
    "logo": {
      "text": "Orbius",
      "component": "src/components/Logo.jsx",
      "size": 32,
      "rounded": true
    },
    "favicon": "/favicon.svg",
    "faviconIco": "/favicon.ico",
    "appleTouchIcon": "/icons/icon-180.png",
    "documentTitle": "Orbius — Always in orbit. Always evolving.",
    "cssModule": "src/App.module.css",
    "shellClasses": ["app", "header", "logo", "logoText", "nav", "navTrack", "navBtn", "navBtnActive", "main"]
  },
  "pages": {
    "dashboard": {
      "id": "dashboard",
      "component": "src/components/DashboardPage.jsx",
      "cssModule": "src/components/DashboardPage.module.css",
      "pageTitle": "Dashboard",
      "pageIcon": "gauge",
      "statBoxes": [
        { "id": "bodyWeight", "label": "Body Weight", "unit": "kg", "valueKey": "lastBodyWeight" },
        { "id": "bodyFat", "label": "Body Fat", "unit": "%", "valueKey": "lastBodyFat", "colorToken": "pink" },
        { "id": "todayCals", "label": "Today Cals", "unit": "kcal", "valueKey": "todayCalories", "colorToken": "orange", "emptyAsNull": true },
        { "id": "workouts", "label": "Workouts", "unit": "", "valueKey": "workoutCount", "colorToken": "green" }
      ],
      "sections": [
        {
          "id": "personalRecords",
          "type": "card",
          "title": "🏆 Personal Records",
          "emptyIcon": "🏋️",
          "emptyMessage": "No workouts yet.",
          "emptyCta": "Log your first workout!",
          "emptyCtaTab": "Workout"
        }
      ],
      "collapses": [
        { "id": "recentWorkouts", "emoji": "📋", "label": "Recent Workouts", "defaultOpen": false, "emptyIcon": "📝", "emptyMessage": "Nothing logged yet!" }
      ]
    },
    "workout": {
      "id": "workout",
      "component": "src/components/WorkoutPage.jsx",
      "cssModule": "src/components/WorkoutPage.module.css",
      "hero": {
        "eyebrow": "Training dashboard",
        "title": "Workout Log",
        "icon": "activity",
        "statLayout": "filled-strip",
        "statMetrics": [
          { "id": "workouts", "label": "Workouts" },
          { "id": "unique", "label": "Unique" },
          { "id": "today", "label": "Today" }
        ]
      },
      "actions": [
        { "id": "calendar", "label": "📅 Open Calendar" },
        { "id": "smartParser", "label": "🧠 Smart Parser" }
      ],
      "collapses": [
        { "id": "logWorkout", "icon": "pencil-line", "label": "Log Workout", "defaultOpen": false },
        { "id": "history", "icon": "notebook", "label": "Workout History", "defaultOpen": false },
        { "id": "oneRm", "icon": "square-function", "label": "1RM Calculator", "defaultOpen": false }
      ],
      "historyGroups": {
        "defaultExpanded": true,
        "expandAllPersistsAcrossGrouping": true
      },
      "modals": [
        { "id": "calendarModal", "title": "📅 Workout Calendar", "layerId": "calendar-modal", "monthMaxWidthPx": 389, "yearMaxWidthPx": 680 },
        { "id": "calendarDay", "title": "Day detail", "layerId": "calendar-day-panel", "staysMountedUnder": "calendarLog" },
        { "id": "calendarLog", "title": "✍️ Manual Log", "altTitle": "🧠 Smart Paste", "layerId": "calendar-log-panel", "stacksOver": "calendarDay" },
        { "id": "smartParser", "title": "🧠 Smart Parser", "layerId": "smart-parser", "submitLabel": "Parse & Save", "iconInTitle": true },
        { "id": "setPicker", "title": "Select a logged set", "layerId": "set-picker" },
        { "id": "clearHistory", "title": "Clear Workout History?", "layerId": "clear-workout-history", "buttons": ["Cancel", "Clear History"] }
      ]
    },
    "bodyComp": {
      "id": "bodyComp",
      "component": "src/components/BodyCompPage.jsx",
      "cssModule": "src/components/BodyCompPage.module.css",
      "pageTitle": "Body Composition",
      "pageIcon": "layers",
      "collapses": [
        { "id": "logEntry", "icon": "square-plus", "label": "Log Entry", "defaultOpen": false },
        { "id": "history", "icon": "history", "label": "History", "defaultOpen": false }
      ],
      "modals": [
        { "id": "clearHistory", "title": "Clear Body Comp History?", "layerId": "clear-body-comp-history", "buttons": ["Cancel", "Clear History"] }
      ]
    },
    "calories": {
      "id": "calories",
      "component": "src/components/CaloriePage.jsx",
      "cssModule": "src/components/CaloriePage.module.css",
      "pageTitle": "Calories",
      "pageIcon": "flame",
      "sections": [
        { "id": "bmrTdee", "title": "🔥 BMR & TDEE" },
        { "id": "dailyGoal", "title": "Daily Goal" }
      ],
      "collapses": [
        { "id": "customEntry", "emoji": "✏️", "label": "Custom Entry", "defaultOpen": false },
        { "id": "foodLog", "emoji": "📋", "label": "Log for {date}", "defaultOpen": true, "labelTemplate": true }
      ],
      "goalChips": [
        { "id": "cut", "label": "Cut (-500)", "colorToken": "red", "offsetKey": "cut" },
        { "id": "maintain", "label": "Maintain", "colorToken": "green", "offsetKey": "maintain" },
        { "id": "bulk", "label": "Bulk (+300)", "colorToken": "accent", "offsetKey": "bulk" }
      ],
      "tdeeBreakdown": {
        "layout": ["formula", "bar", "legend", "equation"],
        "formulaTemplates": {
          "mifflinMale": "BMR = 10 × weight + 6.25 × height − 5 × age + 5 (Male)",
          "mifflinFemale": "BMR = 10 × weight + 6.25 × height − 5 × age − 161 (Female)",
          "katch": "BMR = 370 + 21.6 × FFM (Katch-McArdle)"
        },
        "rows": [
          { "id": "bmr", "shortLabel": "BMR", "hint": "Basal metabolic rate", "colorToken": "orange" },
          { "id": "tef", "shortLabel": "TEF", "hint": "Food thermic effect · 10%", "colorToken": "yellow" },
          { "id": "neat", "shortLabel": "NEAT", "hint": "Non-exercise activity", "colorToken": "blue" },
          { "id": "eat", "shortLabel": "EAT", "hint": "Exercise activity", "colorToken": "blue" },
          { "id": "paee", "shortLabel": "PAEE", "hint": "Activity energy", "colorToken": "accent", "detailIds": ["neat", "eat"] }
        ],
        "equation": ["bmr", "tef", "paee"],
        "barSegments": [
          { "id": "bmr", "colorClass": "tdeeBarBmr" },
          { "id": "tef", "colorClass": "tdeeBarTef" },
          { "id": "paee", "colorClass": "tdeeBarPaee" }
        ]
      }
    },
    "progress": {
      "id": "progress",
      "component": "src/components/ProgressPage.jsx",
      "cssModule": "src/components/ProgressPage.module.css",
      "pageTitle": "Progress",
      "pageIcon": "chart-spline",
      "sections": [
        { "id": "compoundLifts", "label": "🏋️ COMPOUND LIFTS" },
        { "id": "combinedCompound", "title": "📊 Combined Compound Lifts" },
        { "id": "isolationLifts", "label": "💪 ISOLATION LIFTS" },
        { "id": "bodyCharts", "title": "📉 Body Weight & Body Fat" },
        { "id": "calorieTrend", "title": "🔥 Calorie Intake Trend" }
      ],
      "chartMetrics": ["weight", "volume", "e1rm", "mean_e1rm"],
      "sessionGraphMetrics": ["weight", "volume", "e1rm"],
      "modals": [
        { "id": "workoutDetail", "title": "Workout Details", "layerId": "progress-detail" },
        { "id": "sessionGraph", "title": "Session Performance", "layerId": "progress-session-graph" }
      ]
    }
  }
}
