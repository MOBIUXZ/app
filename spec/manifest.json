{
  "$schema": "./manifest.schema.json",
  "version": 4,
  "description": "Orbius machine-readable specification manifest. Specs are the source of truth; code and docs must conform.",
  "specs": [
    {
      "id": "exercise-aliases",
      "path": "spec/exercise-aliases.json",
      "governs": ["resolveExercise()", "Smart Parser exercise headers"],
      "docs": ["docs/data-model.md", "docs/shared-utilities.md"]
    },
    {
      "id": "exercise-catalog",
      "path": "spec/exercise-catalog.json",
      "governs": ["EXERCISE_CATEGORIES", "COMPOUND_LIFTS", "chart colors", "TDEE activity levels", "theme color constants in JS"],
      "docs": ["docs/data-model.md", "docs/workout.md", "docs/progress.md", "docs/styling.md"]
    },
    {
      "id": "theme-tokens",
      "path": "spec/theme-tokens.json",
      "governs": ["src/styles/theme.css CSS custom properties"],
      "docs": ["docs/styling.md"]
    },
    {
      "id": "app-config",
      "path": "spec/app-config.json",
      "governs": ["localStorage key", "default data shape", "chart animation timing", "dashboard/calorie defaults", "nav tab ids"],
      "docs": ["docs/architecture.md", "docs/progress.md", "docs/data-model.md"]
    },
    {
      "id": "data-model",
      "path": "spec/data-model.schema.json",
      "governs": ["ft_v5 persistence schema"],
      "docs": ["docs/data-model.md"]
    },
    {
      "id": "parser-fixtures",
      "path": "spec/parser-fixtures.json",
      "governs": ["parseWorkoutText() contract"],
      "docs": ["docs/workout.md", "docs/shared-utilities.md"]
    },
    {
      "id": "formula-fixtures",
      "path": "spec/formula-fixtures.json",
      "governs": ["estimate1RM", "computeSessionMetrics", "computeBodyCompEntry"],
      "docs": ["docs/data-model.md", "docs/progress.md", "docs/body-comp.md"]
    },
    {
      "id": "resolve-exercise-fixtures",
      "path": "spec/resolve-exercise-fixtures.json",
      "governs": ["resolveExercise() alias and normalization rules"],
      "docs": ["docs/shared-utilities.md"]
    },
    {
      "id": "one-rm-formulas",
      "path": "spec/one-rm-formulas.json",
      "governs": ["Workout page 1RM calculator formulas and training percentages"],
      "docs": ["docs/workout.md"]
    },
    {
      "id": "ui-behavior-fixtures",
      "path": "spec/ui-behavior-fixtures.json",
      "governs": ["Dashboard PRs/recent stats", "Calorie macro totals/TDEE/goal bar", "Body comp bodyLogs sync", "Workout History expand/collapse across grouping"],
      "docs": ["docs/dashboard.md", "docs/calories.md", "docs/body-comp.md", "docs/workout.md"]
    },
    {
      "id": "chart-domain",
      "path": "spec/chart-domain.json",
      "governs": ["Progress chart Y-axis domain", "chart cursor styling", "failed set color"],
      "docs": ["docs/progress.md"]
    },
    {
      "id": "keyboard-shortcuts",
      "path": "spec/keyboard-shortcuts.json",
      "governs": ["Global nav keys", "list navigation", "parser textarea keys", "popup layer ids"],
      "docs": ["docs/keyboard-navigation.md"]
    },
    {
      "id": "file-tree",
      "path": "spec/file-tree.json",
      "governs": ["expected project source layout"],
      "docs": ["docs/source-index.md", "docs/RECONSTRUCTION.md"]
    },
    {
      "id": "page-layout",
      "path": "spec/page-layout.json",
      "governs": ["page titles", "page icons", "sections", "stat boxes", "collapses", "modal titles", "hero blocks"],
      "docs": ["docs/dashboard.md", "docs/workout.md", "docs/body-comp.md", "docs/calories.md", "docs/progress.md", "docs/architecture.md"]
    },
    {
      "id": "page-icons",
      "path": "spec/page-icons.json",
      "governs": ["Lucide page-title icon paths", "PageIcon / PageHeading"],
      "docs": ["docs/styling.md", "docs/source-index.md"]
    },
    {
      "id": "css-modules",
      "path": "spec/css-modules.json",
      "governs": ["required CSS module class names per file"],
      "docs": ["docs/styling.md"]
    },
    {
      "id": "global-styles",
      "path": "spec/global-styles.json",
      "governs": ["global.css keyboard classes", "base rules", "number input behavior"],
      "docs": ["docs/styling.md", "docs/keyboard-navigation.md"]
    },
    {
      "id": "ui-module",
      "path": "spec/ui-module.json",
      "governs": ["shared UI component CSS class mapping", "modal/chart toggle classes"],
      "docs": ["docs/styling.md", "docs/shared-utilities.md"]
    },
    {
      "id": "style-helpers",
      "path": "spec/style-helpers.json",
      "governs": ["styleHelpers.js exports and modifier keys"],
      "docs": ["docs/styling.md"]
    },
    {
      "id": "visual-regression",
      "path": "spec/visual-regression.json",
      "governs": ["Playwright visual snapshots", "viewport", "pages to capture"],
      "docs": ["docs/MANUAL-QA.md"]
    },
    {
      "id": "visual-seed-data",
      "path": "spec/visual-seed-data.json",
      "governs": ["Deterministic localStorage for visual QA"],
      "docs": ["docs/MANUAL-QA.md"]
    },
    {
      "id": "manual-qa-checklist",
      "path": "spec/manual-qa-checklist.json",
      "governs": ["Human QA checklist for releases"],
      "docs": ["docs/MANUAL-QA.md"]
    }
  ],
  "testSuites": [
    { "path": "tests/parser.test.js", "spec": "parser-fixtures" },
    { "path": "tests/resolve-exercise.test.js", "spec": "resolve-exercise-fixtures" },
    { "path": "tests/metrics.test.js", "spec": "formula-fixtures" },
    { "path": "tests/one-rm.test.js", "spec": "one-rm-formulas" },
    { "path": "tests/ui-behavior.test.js", "spec": "ui-behavior-fixtures" },
    { "path": "tests/chart-domain.test.js", "spec": "chart-domain" },
    { "path": "tests/theme.test.js", "spec": "theme-tokens" },
    { "path": "tests/keyboard-shortcuts.test.js", "spec": "keyboard-shortcuts" },
    { "path": "tests/page-layout.test.js", "spec": "page-layout" },
    { "path": "tests/page-icons.test.js", "spec": "page-icons" },
    { "path": "tests/css-modules.test.js", "spec": "css-modules" },
    { "path": "tests/global-styles.test.js", "spec": "global-styles" },
    { "path": "tests/ui-module.test.js", "spec": "ui-module" },
    { "path": "tests/style-helpers.test.js", "spec": "style-helpers" },
    { "path": "tests/visual-regression.test.js", "spec": "visual-regression" },
    { "path": "tests/manual-qa-checklist.test.js", "spec": "manual-qa-checklist" },
    { "path": "tests/file-tree.test.js", "spec": "file-tree" },
    { "path": "tests/spec-integrity.test.js", "spec": "manifest" }
  ]
}
