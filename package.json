{
  "name": "orbius",
  "version": "1.0.0",
  "description": "Orbius — personal fitness tracking with smart parser, metrics, and progress charts",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:install": "playwright install chromium",
    "spec:check": "node scripts/verify-spec.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "theme:generate": "node scripts/generate-theme-css.mjs",
    "verify": "npm run spec:check && npm run docs:check && npm run theme:generate && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:visual"
  }
}
